# =============================================================
# Frontend Variables (VITE_ prefix = baked into the JS bundle at build time)
# ⚠️  Never put secret API keys here — these values are visible in the browser!
# =============================================================
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
# Local dev: http://localhost:8000/api/v1  |  Production: https://api.yourdomain.com/api/v1
# ⚠️  MUST include the /api/v1 prefix — the frontend builds all API paths on top of this.
VITE_API_URL="http://localhost:8000/api/v1"
VITE_MAX_IMAGE_SIZE_MB=20
VITE_MAX_MANUAL_SIZE_MB=20

# =============================================================
# Backend — Supabase Connection
# =============================================================
SUPABASE_URL=https://your-project.supabase.co
# Only for `docker compose` with a local Supabase: the backend container can't reach
# 127.0.0.1 on your machine, so give it this URL instead.
# SUPABASE_URL_FROM_DOCKER=http://host.docker.internal:54321
# The service role key — keep secret, only used server-side
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# =============================================================
# Backend — AI Providers (only fill in the key for AI_PROVIDER you use)
# =============================================================
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Available providers: google (tested), openai (untested: see README "Using OpenAI")
AI_PROVIDER=google
GOOGLE_AI_MODEL=gemini-2.5-flash
OPENAI_AI_MODEL=gpt-4o
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# =============================================================
# Backend — RAG Settings
# =============================================================
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000

# =============================================================
# Backend — Rate Limiting
# Requests per IP per window (requests / seconds)
# =============================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================
# Backend — Application Settings
# ENVIRONMENT: "development" (enables /docs, debug mode) | "production" (hides /docs)
# CORS_ORIGINS: JSON list — local dev uses localhost, prod uses your real domain
# =============================================================
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8080"]
# Production CORS example:
# CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
MAX_MANUAL_SIZE_MB=20

# =============================================================
# Backend — AI Classification Pipeline
# =============================================================
# Background job that groups chat questions into themes for Analytics (uses AI tokens)
CLASSIFICATION_ENABLED=true
CLASSIFICATION_MODEL=gemini-2.5-flash
CLASSIFICATION_BATCH_SIZE=50
CLASSIFICATION_SIMILARITY_THRESHOLD=0.85
RETITLE_MILESTONES="5,15,50"
RETITLE_SAMPLE_SIZE=10
CLASSIFICATION_INTERVAL_MINUTES=60

# =============================================================
# Backend — Notifications (Resend)
# =============================================================
# Optional: leave empty to disable email notifications
RESEND_API_KEY=
RESEND_SENDER_EMAIL="DokSights <noreply@yourdomain.com>"
FRONTEND_URL=http://localhost:8080