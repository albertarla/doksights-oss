{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest*)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm ci --dry-run)",
      "Bash(bash scripts/run-all-checks.sh*)",
      "Bash(gitleaks *)",
      "Bash(supabase status*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "ask": ["Bash(git push*)", "Bash(git tag*)", "Bash(git reset --hard*)", "Bash(supabase db push*)"],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-file.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
